# Leo Bot v1.37.6 — environment variables that should NOT be hardcoded
# Never commit .env or real API keys.

# WhatsApp / deployment identity
OWNER_NUMBER=
BOT_NUMBER=
BOT_OWNER_NAME=
PAIRING_CODE=false
CHANNEL_JID=
CHANNEL_LINK=
CHANNEL_NAME=

# OmniRoute
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=
# Optional model override. Leave empty to let OmniRoute choose automatically.
OMNIROUTE_TEXT_MODEL=
# Optional OmniRoute TTS model. Must be provider/model; leave empty for local gTTS fallback.
OMNIROUTE_TTS_MODEL=

# AI fallback credentials
OPENAI_API_KEY=
GEMINI_API_KEY=
GIFTED_API_KEY=

# Cloudflare Workers AI fallback credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hugging Face video fallback credential
HF_TOKEN=

# Independent command/service credentials
REMOVEBG_API_KEY=

# SnapTube / yt-dlp session support (keep these out of Git).
# YTDLP_COOKIES_B64 should contain a base64-encoded Netscape cookies.txt file.
# Prefer YTDLP_COOKIES_B64 over the raw YTDLP_COOKIES variable.
# These cookies are used only by .سنابتيوب.
YTDLP_COOKIES_B64=
