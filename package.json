{
  "name": "leo-whatsapp-bot",
  "version": "1.37.2",
  "description": "Leo Bot — Arabic-first WhatsApp entertainment, assistant and AI bot",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:optimized": "node --max-old-space-size=512 --optimize-for-size --gc-interval=100 index.js",
    "install:panel": "npm install --legacy-peer-deps",
    "install:force": "npm install --force",
    "test": "node scripts-syntax-check.js && node scripts-registry-audit.js && node scripts-retired-commands-audit.js && node scripts-help-registry-audit.js",
    "test:providers": "node scripts-provider-check.js",
    "providers:health": "node scripts-provider-health.js",
    "providers:reset": "node -e \"require('./lib/providers/core/health').reset(); console.log('Provider circuit state reset')\"",
    "data:backup": "node scripts-data-backup.js",
    "data:backups": "node scripts-data-backups.js",
    "data:restore": "node scripts-data-restore.js",
    "start:pairing": "node index.js --pairing-code",
    "start:velrix": "node index.js",
    "pair:velrix": "node index.js --pairing-code",
    "start:production": "node --max-old-space-size=512 index.js",
    "audit:registry": "node scripts-registry-audit.js",
    "registry:preflight": "node scripts-registry-preflight.js",
    "test:pdf": "node scripts/pdf-tools-check.js",
    "test:systems": "node scripts-systems-test.js",
    "test:ai-reliability": "node scripts-ai-reliability-test.js",
    "test:ai-verification": "node scripts-ai-verification-test.js",
    "test:ai-evaluation": "node scripts-ai-evaluation-suite.js",
    "test:ai-production": "node scripts-ai-production-audit.js",
    "audit:help": "node scripts-help-registry-audit.js",
    "audit:retired": "node scripts-retired-commands-audit.js",
    "test:storage": "node scripts-storage-test.js",
    "test:economy-paid": "node scripts-economy-paid-test.js",
    "test:interaction": "node scripts-interaction-test.js",
    "audit:legacy": "node scripts-legacy-audit.js",
    "audit:main": "node scripts-main-routing-audit.js",
    "test:contracts": "node scripts-command-contract-test.js",
    "test:response": "node scripts-response-contract-test.js",
    "test:cooldown-economy": "node scripts-cooldown-economy-test.js",
    "test:provider-fallback": "node scripts-provider-fallback-quality-test.js",
    "test:provider-normalization": "node scripts-provider-normalization-test.js",
    "test:provider-retry": "node scripts-provider-retry-test.js",
    "test:command-observability": "node scripts-command-observability-test.js",
    "test:event-modules": "node scripts-event-modules-test.js"
  },
  "keywords": [
    "whatsapp-bot"
  ],
  "author": "Leonardo",
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "awesome-phonenumber": "^5.9.0",
    "axios": "^1.8.4",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.4.5",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.1",
    "fs-extra": "^11.2.0",
    "gtts": "^0.2.1",
    "human-readable": "^0.2.1",
    "jimp": "^1.6.0",
    "libphonenumber-js": "^1.11.18",
    "moment-timezone": "^0.5.43",
    "mumaker": "^2.0.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^2.7.0",
    "node-id3": "^0.2.3",
    "node-webpmux": "^3.1.0",
    "node-youtube-music": "^0.8.3",
    "pino": "^8.21.0",
    "ruhend-scraper": "^8.3.0",
    "sharp": "^0.32.6",
    "youtube-yts": "^2.0.0",
    "yt-search": "^2.12.1",
    "ytdl-core": "^4.11.5",
    "@distube/ytdl-core": "^4.16.12",
    "btch-downloader": "^6.3.6",
    "node-edge-tts": "^1.2.10"
  },
  "overrides": {
    "jimp": "^1.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
